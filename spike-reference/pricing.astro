---
import { requestWithMetadata, tinaField } from "@tinacms/astro";
import client from "../../tina/__generated__/client";
import "../styles/main.css";

// Same data the Eleventy site renders, loaded through Tina so the editor
// can map each element back to its field.
const result = await requestWithMetadata(
  client.queries.pricing({ relativePath: "pricing.json" }),
);
const pricing = result.data.pricing;
const cancellation = `A $${pricing.cancellation?.fee} fee may apply to appointments canceled with less than ${pricing.cancellation?.noticeHours} hours' notice.`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pricing — Premier Wellness Telehealth</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Manrope:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main id="main">
      <header class="page-banner">
        <div class="container">
          <div class="eyebrow">Self-Pay Pricing</div>
          <h1>Transparent <em>pricing</em>, no surprises.</h1>
          <p class="lede" data-tina-field={tinaField(pricing, "intro")}>
            {pricing.intro}
          </p>
        </div>
      </header>

      <svg class="wave-divider" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,40 C240,70 480,10 720,30 C960,55 1200,15 1440,40 L1440,80 L0,80 Z" fill="#B08D3E" opacity=".22"></path>
        <path d="M0,55 C240,75 480,25 720,50 C960,75 1200,30 1440,55 L1440,80 L0,80 Z" fill="#F3EEDF"></path>
      </svg>

      <section class="pricing">
        <div class="container">
          <div class="pricing-grid">
            {
              pricing.visits?.map((visit: any, i: number) => (
                <article class="price-card">
                  <h3 data-tina-field={tinaField(pricing, `visits.${i}.name` as any)}>
                    {visit?.name}
                  </h3>
                  <div
                    class="price-amount"
                    data-tina-field={tinaField(pricing, `visits.${i}.amount` as any)}
                  >
                    ${visit?.amount}
                  </div>
                  <div class="price-unit">{visit?.unit}</div>
                  <p data-tina-field={tinaField(pricing, `visits.${i}.description` as any)}>
                    {visit?.description}
                  </p>
                </article>
              ))
            }
          </div>

          <div class="pricing-notes">
            <h4>What to know</h4>
            <ul>
              {pricing.notes?.map((note: any) => <li>{note}</li>)}
              <li>{cancellation}</li>
            </ul>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
