---
import Icon from "../Icon.astro";
import { site } from "../../lib/derived.js";
import nav from "../../_data/nav.json";

const current = Astro.url.pathname;
const isCurrent = (url: string) =>
  url === "/" ? current === "/" : current.startsWith(url);
---

<nav class="main" aria-label="Main">
  <div class="nav-inner">
    <a href="/" class="brand">
      <img src={site.logo} alt={site.name} width="44" height="44" />
      <span class="brand-text">
        <span class="b1">{site.brand.line1}</span>
        <span class="b2">{site.brand.line2}</span>
      </span>
    </a>

    <div class="nav-links" id="navLinks">
      {
        nav.primary.map((item) => (
          <a href={item.url} aria-current={isCurrent(item.url) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </div>

    {
      site.booking.url ? (
        <a class="nav-cta" href={site.booking.url} target="_blank" rel="noopener">
          {site.ctaLabel}
        </a>
      ) : (
        <button class="nav-cta" type="button" data-open-booking>
          {site.ctaLabel}
        </button>
      )
    }

    <button
      class="menu-toggle"
      type="button"
      id="menuToggle"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="navLinks"
    >
      <Icon name="menu" size={26} />
    </button>
  </div>
</nav>
