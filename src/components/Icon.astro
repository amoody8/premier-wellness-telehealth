---
/**
 * Named icon from the registry in src/_data/icons.js.
 *
 * Unknown names render nothing rather than breaking the page — a CMS
 * entry with a stale icon name should never take the site down.
 */
import icons from "../_data/icons.js";

interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 24, strokeWidth = 2, class: className } = Astro.props;
const glyph = (icons as Record<string, string>)[name];
---

{
  glyph && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      class={className}
      set:html={glyph}
    />
  )
}
