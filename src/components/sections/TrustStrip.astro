---
import Icon from "../Icon.astro";

interface Props {
  items: any[];
  tinaPrefix?: (field: string) => string | undefined;
}
const { items, tinaPrefix } = Astro.props;
const tf = (f: string) => (tinaPrefix ? tinaPrefix(f) : undefined);
---

<section class="trust-strip">
  <div class="container trust-grid">
    {
      items?.map((item: any, i: number) => (
        <div class="trust-item">
          <div class="trust-icon">
            <Icon name={item.icon} size={36} strokeWidth={1.5} />
          </div>
          <div>
            <h4 data-tina-field={tf(`trustItems.${i}.heading`)}>{item.heading}</h4>
            <p data-tina-field={tf(`trustItems.${i}.body`)}>{item.body}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
