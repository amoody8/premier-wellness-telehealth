{% from "macros/icon.njk" import icon %}
<section class="trust-strip">
  <div class="container trust-grid">
    {%- for item in trustItems %}
    <div class="trust-item">
      <div class="trust-icon">{{ icon(item.icon, icons, 36, 1.5) }}</div>
      <div>
        <h4>{{ item.heading }}</h4>
        <p>{{ item.body }}</p>
      </div>
    </div>
    {%- endfor %}
  </div>
</section>
