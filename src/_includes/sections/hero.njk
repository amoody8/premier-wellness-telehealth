{% from "macros/icon.njk" import icon %}
<header class="hero" id="main">
  <div class="container hero-grid">
    <div class="hero-copy">
      {% if hero.eyebrow %}<div class="eyebrow">{{ hero.eyebrow }}</div>{% endif %}
      <h1>{{ hero.headline | inlineMarkdown | safe }}</h1>
      <p class="hero-lede">{{ hero.lede }}</p>

      <div class="hero-ctas">
        {% if site.booking.url %}
        <a class="btn btn-primary" href="{{ site.booking.url }}" target="_blank" rel="noopener">
          {{ site.ctaLabel }}
          {{ icon("arrow-right", icons, 14, 2.5) }}
        </a>
        {% else %}
        <button class="btn btn-primary" type="button" data-open-booking>
          {{ site.ctaLabel }}
          {{ icon("arrow-right", icons, 14, 2.5) }}
        </button>
        {% endif %}
        <a href="{{ hero.secondaryCta.url }}" class="btn btn-outline">{{ hero.secondaryCta.label }}</a>
      </div>

      <div class="hero-trust">
        <span class="badge">{{ icon("shield-check", icons, 16) }}</span>
        <span>Serving {{ derived.statesAmp }} · HIPAA-compliant care for adults {{ site.minimumAge }}+</span>
      </div>
    </div>

    {% if hero.image %}
    <div class="hero-photo">
      <img src="{{ hero.image }}" alt="{{ hero.imageAlt }}" width="800" height="960" />
    </div>
    {% else %}
    <div class="hero-photo hero-photo--placeholder">
      <img src="{{ site.logo }}" alt="" width="200" height="200" />
    </div>
    {% endif %}
  </div>
</header>
