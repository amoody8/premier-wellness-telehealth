{% from "macros/icon.njk" import icon %}
<div class="topbar">
  <div class="topbar-inner">
    <div class="topbar-left">
      <span>
        {{ icon("mail", icons, 12, 2.2) }}
        <a href="mailto:{{ site.email }}">Contact us</a>
      </span>
    </div>
    <div class="topbar-word">{{ site.wordmark.pre }} <em>{{ site.wordmark.em }}</em> {{ site.wordmark.post }}</div>
    <div class="topbar-right">
      {% if site.booking.url %}
      <a class="btn-small" href="{{ site.booking.url }}" target="_blank" rel="noopener">{{ site.ctaLabel }}</a>
      {% else %}
      <button class="btn-small" type="button" data-open-booking>{{ site.ctaLabel }}</button>
      {% endif %}
    </div>
  </div>
</div>
