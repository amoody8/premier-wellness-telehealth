{% from "macros/icon.njk" import icon %}
<nav class="main" aria-label="Main">
  <div class="nav-inner">
    <a href="{{ "/" | url }}" class="brand">
      <img src="{{ site.logo | url }}" alt="{{ site.name }}" width="44" height="44" />
      <span class="brand-text">
        <span class="b1">{{ site.brand.line1 }}</span>
        <span class="b2">{{ site.brand.line2 }}</span>
      </span>
    </a>

    <div class="nav-links" id="navLinks">
      {%- for item in nav.primary %}
      <a href="{{ item.url | url }}"{% if page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </div>

    {% if site.booking.url %}
    <a class="nav-cta" href="{{ site.booking.url }}" target="_blank" rel="noopener">{{ site.ctaLabel }}</a>
    {% else %}
    <button class="nav-cta" type="button" data-open-booking>{{ site.ctaLabel }}</button>
    {% endif %}

    <button class="menu-toggle" type="button" id="menuToggle" aria-label="Menu" aria-expanded="false" aria-controls="navLinks">
      {{ icon("menu", icons, 26) }}
    </button>
  </div>
</nav>
