---
layout: layouts/base.njk
---
{% from "macros/icon.njk" import icon %}
<main id="main">
  <header class="page-banner">
    <div class="container">
      <div class="eyebrow">Services</div>
      <h1>{{ title }}</h1>
      {% if intro %}<p class="lede">{{ intro }}</p>{% endif %}
    </div>
  </header>

  {% include "partials/wave-divider.njk" %}

  <section class="category-wrap">
    <div class="container">
      <div class="group-grid">
        {%- for group in groups %}
        <article class="group-card">
          <h3>{{ icon(group.icon, icons, 22, 1.6) }}{{ group.title }}</h3>
          {% if group.body %}<p>{{ group.body }}</p>{% endif %}
          <ul>
            {%- for item in group.items %}
            <li>{{ item }}</li>
            {%- endfor %}
          </ul>
        </article>
        {%- endfor %}
      </div>

      {% if clinicalNote %}
      <div class="clinical-note">
        <strong>Important clinical information</strong>
        {{ clinicalNote }}
      </div>
      {% endif %}

      {{ content | safe }}
    </div>
  </section>

  <section class="bottom-cta">
    <div class="container">
      <h3>Ready to be <em>seen</em>?</h3>
      <p>Schedule a visit and we'll take the time to understand what's going on.</p>
      <div class="btn-row">
        <a href="{{ "/services/" | url }}" class="btn btn-outline">All Services</a>
        {% if site.booking.url %}
        <a class="btn btn-primary" href="{{ site.booking.url }}" target="_blank" rel="noopener">{{ site.ctaLabel }}</a>
        {% else %}
        <button class="btn btn-primary" type="button" data-open-booking>{{ site.ctaLabel }}</button>
        {% endif %}
      </div>
    </div>
  </section>
</main>
