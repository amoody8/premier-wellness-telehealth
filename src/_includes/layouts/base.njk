<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}" />

<link rel="canonical" href="{{ page.url | url | absolute(site.origin) }}" />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#122845" />

<link rel="icon" type="image/png" href="{{ site.favicon | url }}" />
<link rel="apple-touch-icon" href="{{ site.favicon | url }}" />

<meta property="og:type" content="{{ ogType or 'website' }}" />
<meta property="og:site_name" content="{{ site.name }}" />
<meta property="og:title" content="{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}" />
<meta property="og:description" content="{{ description or site.description }}" />
<meta property="og:image" content="{{ site.logo | url | absolute(site.origin) }}" />
<meta property="og:url" content="{{ page.url | url | absolute(site.origin) }}" />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}" />
<meta name="twitter:description" content="{{ description or site.description }}" />
<meta name="twitter:image" content="{{ site.logo | url | absolute(site.origin) }}" />

<script type="application/ld+json">
{{ jsonLd | safe }}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="{{ "/assets/css/main.css" | url }}" />
</head>
<body>

<a href="#main" class="skip-link">Skip to main content</a>

{% include "partials/topbar.njk" %}
{% include "partials/nav.njk" %}

{{ content | safe }}

{% include "partials/footer.njk" %}
{% include "partials/book-modal.njk" %}

<script src="{{ "/assets/js/site.js" | url }}" defer></script>
</body>
</html>
