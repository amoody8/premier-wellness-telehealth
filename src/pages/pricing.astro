---
import { requestWithMetadata, tinaField } from "@tinacms/astro";
import client from "../../tina/__generated__/client";
import Base from "../layouts/Base.astro";
import WaveDivider from "../components/partials/WaveDivider.astro";
import CtaStrip from "../components/sections/CtaStrip.astro";
import { derived } from "../lib/derived.js";

const result = await requestWithMetadata(
  client.queries.pricing({ relativePath: "pricing.json" }),
);
const pricing = result.data.pricing;
---

<Base
  title="Pricing"
  description="Transparent self-pay pricing for virtual visits. New patient $115, follow-up $85, lab review $65, medication refill $55."
>
  <main id="main">
    <header class="page-banner">
      <div class="container">
        <div class="eyebrow">Self-Pay Pricing</div>
        <h1>Transparent <em>pricing</em>, no surprises.</h1>
        <p class="lede" data-tina-field={tinaField(pricing, "intro")}>
          {pricing.intro}
        </p>
      </div>
    </header>

    <WaveDivider />

    <section class="pricing">
      <div class="container">
        <div class="pricing-grid">
          {
            pricing.visits?.map((visit: any, i: number) => (
              <article class="price-card">
                <h3 data-tina-field={tinaField(pricing, `visits.${i}.name` as any)}>
                  {visit?.name}
                </h3>
                <div
                  class="price-amount"
                  data-tina-field={tinaField(pricing, `visits.${i}.amount` as any)}
                >
                  ${visit?.amount}
                </div>
                <div class="price-unit">{visit?.unit}</div>
                <p data-tina-field={tinaField(pricing, `visits.${i}.description` as any)}>
                  {visit?.description}
                </p>
              </article>
            ))
          }
        </div>

        <div class="pricing-notes">
          <h4>What to know</h4>
          <ul>
            {pricing.notes?.map((note: any) => <li>{note}</li>)}
            <li>{derived.cancellationPolicy}</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="visit-types">
      <div class="container">
        <div class="visit-types-head">
          <div class="eyebrow eyebrow--centered">Payment</div>
          <h2 class="section-heading">How payment <em>works</em></h2>
        </div>

        <div class="visit-grid">
          <article class="visit-card">
            <h3>Payment at time of service</h3>
            <p>
              Payment is due at the time of your visit. We do not bill or accept
              health insurance, which keeps pricing straightforward and avoids
              insurance authorization requirements.
            </p>
          </article>
          <article class="visit-card">
            <h3>Using your HSA or FSA</h3>
            <p>
              Many patients use HSA or FSA funds for visits. You may request
              documentation of your visit for your personal records;
              reimbursement by an insurance plan is not guaranteed.
            </p>
          </article>
        </div>
      </div>
    </section>

    <CtaStrip />
  </main>
</Base>
