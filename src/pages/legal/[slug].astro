---
import { requestWithMetadata, tinaField } from "@tinacms/astro";
import client from "../../../tina/__generated__/client";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import WaveDivider from "../../components/partials/WaveDivider.astro";
import { renderLegalBody } from "../../lib/legal.js";
import { inlineMarkdown } from "../../lib/markdown.js";
import { site, derived } from "../../lib/derived.js";

const { slug } = Astro.params;

const result = await requestWithMetadata(
  client.queries.legal({ relativePath: `${slug}.md` }),
);
const doc = result.data.legal;

// Section numbers and the contents list come from one pass over the
// headings, so they cannot drift apart. This is what fixed the HIPAA
// off-by-one, where ten headings carried only nine numbers.
const { body, toc } = renderLegalBody(doc.body ?? "", {
  tocSkipFirst: Boolean(doc.tocSkipFirst),
});

const fmtDate = (v: string | null | undefined) => {
  if (!v) return null;
  const d = new Date(v);
  return Number.isNaN(d.getTime())
    ? v
    : d.toLocaleDateString("en-US", {
        year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
      });
};
const effective = fmtDate(doc.effectiveDate);
const updated = fmtDate(doc.lastUpdated);
---

<Base title={doc.title} description={doc.description} ogType="article">
  <main id="main">
    <header class="page-banner">
      <div class="container">
        <div class="eyebrow">{doc.eyebrow}</div>
        <h1 data-tina-field={tinaField(doc, "heading")} set:html={inlineMarkdown(doc.heading)} />
        <div class="updated">
          Effective date: <strong>{effective ?? "To be set on publication"}</strong>
          &nbsp;·&nbsp; Last updated: {updated ?? "Not yet published"}
        </div>
      </div>
    </header>

    <WaveDivider />

    <section class="prose-wrap">
      <div class="container">
        <div class="prose-grid">
          <aside class="toc" aria-label="On this page">
            <h4>On this page</h4>
            <Fragment set:html={toc} />
          </aside>

          <article class="prose">
            {
              doc.draft && (
                <div class="draft-warning" role="note">
                  <span class="ico"><Icon name="alert-triangle" size={28} /></span>
                  <div class="body">
                    <strong>Draft template — attorney review required</strong>
                    <p>
                      This document is a starting point only. Before publishing, have
                      it reviewed by a healthcare attorney licensed in {derived.statesLong}.
                      It is not legal advice and is not a substitute for tailored counsel.
                    </p>
                  </div>
                </div>
              )
            }

            <Fragment set:html={body} />
          </article>
        </div>
      </div>
    </section>

    <section class="bottom-cta">
      <div class="container">
        <h3>Questions?</h3>
        <p>If anything here is unclear, please reach out — we're happy to walk through it with you.</p>
        <div class="btn-row">
          <a href="/legal/" class="btn btn-outline">All Policies</a>
          <a href={`mailto:${site.email}`} class="btn btn-primary">Contact Us</a>
        </div>
      </div>
    </section>
  </main>
</Base>
