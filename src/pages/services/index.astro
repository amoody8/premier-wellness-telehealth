---
import { requestWithMetadata, tinaField } from "@tinacms/astro";
import client from "../../../tina/__generated__/client";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import WaveDivider from "../../components/partials/WaveDivider.astro";
import CtaStrip from "../../components/sections/CtaStrip.astro";
import { contentTokens } from "../../lib/derived.js";
import { inlineMarkdown, resolveTokens } from "../../lib/markdown.js";
import { getServiceCategories } from "../../lib/collections.js";

const result = await requestWithMetadata(
  client.queries.servicesindex({ relativePath: "servicesindex.json" }),
);
const page = result.data.servicesindex;
const tf = (field: string) => tinaField(page, field as any);
const categories = await getServiceCategories();

// The lede mixes editable copy with derived values, so the states and
// provider name stay in sync with site.json while the wording remains
// hers to change.
const lede = resolveTokens(page.lede ?? "", contentTokens);
---

<Base
  title="Services"
  description="Comprehensive adult telehealth — acute and same-day care, primary and preventive care, chronic condition management, women's health, and medical weight management."
>
  <main id="main">
    <header class="page-banner">
      <div class="container">
        <div class="eyebrow">{page.eyebrow}</div>
        <h1 data-tina-field={tf("headline")} set:html={inlineMarkdown(page.headline)} />
        <p class="lede" data-tina-field={tf("lede")}>{lede}</p>
      </div>
    </header>

    <WaveDivider />

    <section class="category-wrap">
      <div class="container">
        <div class="category-list">
          {
            categories.map((cat: any) => (
              <a href={`/services/${cat.slug}/`} class="category-link-card">
                <h3>{cat.data.title}</h3>
                <p>{cat.data.summary}</p>
                <span class="more">
                  Explore <Icon name="arrow-right" size={14} strokeWidth={2.5} />
                </span>
              </a>
            ))
          }
        </div>

        <div class="clinical-note" data-tina-field={tf("clinicalNote")}>
          <strong>{page.clinicalNoteTitle}</strong>
          {page.clinicalNote}
        </div>
      </div>
    </section>

    <section class="bottom-cta">
      <div class="container">
        <div class="emergency-banner" data-tina-field={tf("emergencyNotice")}>
          <strong>Medical emergency</strong>
          {page.emergencyNotice}
        </div>
      </div>
    </section>

    <CtaStrip />
  </main>
</Base>
